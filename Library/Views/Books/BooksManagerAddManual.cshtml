@using Library.Services.Books.Models
@model BookContainerModel


<div class="container">
    <div class="row">
        <div class="col-md-3">
            <!-- Left Navigation -->
            <div class="list-group">
                @Html.ActionLink("Returning", "Index", "Returning", null, new { @class = "list-group-item" })
                @Html.ActionLink("Borrowers", "Index", "Borrowers", null, new { @class = "list-group-item" })
                @Html.ActionLink("Books manager", "Index", "Books", null, new { @class = "list-group-item active" })
                @Html.ActionLink("Teacher service", "Index", "Teacher", null, new { @class = "list-group-item" })
            </div>
        </div>

        <div class="col-md-9">
            @using (Html.BeginForm("BooksManagerAddManual", "Books", FormMethod.Post, new { enctype = "multipart/form-data" }))
            {
                <div class="form-group">
                    @Html.LabelFor(m => m.book.Name, "Name")
                    @Html.TextBoxFor(m => m.book.Name, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.authors, "Author")
                    @Html.TextBoxFor(m => m.authors, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.book.DateRelease, "Date")
                    @Html.TextBoxFor(m => m.book.DateRelease, new { @class = "form-control", type = "date" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.genres, "Genres")
                    @Html.TextBoxFor(m => m.genres, new { @class = "form-control" })
                </div>
                <div class="form-group">
                    @Html.LabelFor(m => m.book.Language, "Language")
                    @Html.TextBoxFor(m => m.book.Language, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.book.LibName, "Library Name")
                    @Html.TextBoxFor(m => m.book.LibName, new { @class = "form-control" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.book.Summary, "Summary")
                    @Html.TextAreaFor(m => m.book.Summary, new { @class = "form-control", rows = "4" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.PhotoUpload, "Upload photo")
                    @Html.TextBoxFor(m => m.PhotoUpload, new { type = "file", @class = "form-control" })
                </div>
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success">
                        @TempData["SuccessMessage"]
                    </div>
                }
                @if (TempData["UnsuccessMessage"] != null)
                {
                    <div class="alert alert-danger">
                        @TempData["UnsuccessMessage"]
                    </div>
                }
                <button type="submit" class="btn btn-primary">Add</button>
            }
        </div>
    </div>
</div>